---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import CaptureForm from '../components/CaptureForm.astro';
import ClipsRail from '../components/ClipsRail.astro';
import PersistentPlayer from '../components/PersistentPlayer.astro';
import { fetchEpisodes, PLATFORMS, CLIPS } from '../lib/episodes.ts';

// Episodes come from the show's Transistor RSS feed at build time,
// so a new episode appears here on the next deploy after it publishes.
const episodes = await fetchEpisodes();
const latest = episodes[0];

const platforms = PLATFORMS;

const upcoming = [
  { num: 2, date: 'Tue, Dec 1, 2026' },
  { num: 3, date: 'Wed, Dec 9, 2026' },
  { num: 4, date: 'Tue, Dec 15, 2026' },
];

const seriesLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'CC3PO Podcast',
  url: 'https://podcast.cc3po.com/',
  description: 'Carlos Cabrales III (CC3PO) — an IT professional and music producer in Lathrop, California — talks plain about the tech small businesses actually run on. One idea per episode, one 10-minute homework task, no selling.',
  image: 'https://podcast.cc3po.com/images/cc3po-podcast-cover.jpg',
  author: { '@type': 'Person', name: 'Carlos Cabrales III' },
  webFeed: 'https://feeds.transistor.fm/cc3po-podcast',
};
---

<Layout
  title="CC3PO Podcast — Carlos Cabrales III"
  description="Carlos Cabrales III (CC3PO) — an IT professional and music producer in Lathrop, California — talks plain about the tech small businesses actually run on. One idea per episode, one 10-minute homework task, no selling."
  image="https://podcast.cc3po.com/images/cc3po-podcast-cover.jpg"
  siteName="CC3PO Podcast"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(seriesLd)} />
  <SiteNav />

  <header class="hero">
    <div class="hero-inner">
      <img src="/images/cc3po-podcast-cover.jpg" alt="CC3PO Podcast cover art" class="hero-cover" width="300" height="300" />
      <div class="hero-text">
        <div class="hero-badge">🎙️ New episodes Tuesdays</div>
        <h1 class="hero-title">CC3PO <span class="accent">Podcast</span></h1>
        <p class="hero-tagline">Plain talk about the tech your business actually runs on.</p>
        <p class="hero-sub">Carlos Cabrales III — an IT professional and music producer in Lathrop, California — takes one idea per episode, gives you one 10-minute homework task, and sells you nothing. Every episode closes with a short segment in Spanish.</p>
        <p class="disclosure">Voiced with an AI clone of Carlos's voice, approved by Carlos.</p>
      </div>
    </div>
    <div class="player-wrap">
      <p class="player-label">Latest episode</p>
      <iframe width="100%" height="180" frameborder="no" scrolling="no" seamless src="https://share.transistor.fm/e/cc3po-podcast/latest" title="Latest episode player"></iframe>
    </div>
  </header>

  <section id="subscribe" class="subscribe">
    <h2 class="section-title">Listen Anywhere</h2>
    <p class="section-desc">The show is live on every major podcast app. Pick your player — or use the one door: <a href="/follow/">podcast.cc3po.com/follow</a></p>
    <div class="subscribe-grid">
      {platforms.map((p) => (
        <a href={p.href} class="subscribe-card" target="_blank" rel="noopener"><span>{p.name}</span></a>
      ))}
    </div>
  </section>

  <section id="episodes" class="episodes">
    <h2 class="section-title">Episodes</h2>
    <form class="ep-search" role="search" action="/episodes/" method="get">
      <label for="home-q">Search episodes, notes, and transcripts</label>
      <div class="ep-search-row">
        <input id="home-q" name="q" type="search" placeholder="Try “backup” or “login”…" />
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
      </div>
    </form>
    <div class="episode-list">
      {episodes.map((ep) => (
        <article class="episode-card">
          <p class="ep-meta">E{ep.num} · {ep.date} · {ep.duration}</p>
          <h3 class="ep-title"><a href={`/episodes/${ep.slug}/`}>{ep.title}</a></h3>
          <p class="ep-desc">{ep.descText}</p>
          <div class="ep-actions">
            <button type="button" class="btn btn-primary btn-sm" data-play={ep.audio} data-play-title={`E${ep.num}: ${ep.title}`} data-play-href={`/episodes/${ep.slug}/`}>▶ Play</button>
            <a href={`/episodes/${ep.slug}/`} class="btn btn-outline btn-sm">Notes & transcript</a>
            {ep.audio && <a href={ep.audio} class="btn btn-outline btn-sm">Download MP3</a>}
          </div>
        </article>
      ))}
    </div>
    <h3 class="schedule-title">Season 1 — coming up</h3>
    <div class="schedule-list">
      {upcoming.map((u) => (
        <div class="schedule-row"><span class="schedule-ep">Episode {u.num}</span><span class="schedule-date">{u.date}</span></div>
      ))}
      <div class="schedule-row"><span class="schedule-ep">Holiday break</span><span class="schedule-date">Dec 21 – Jan 4</span></div>
      <div class="schedule-row"><span class="schedule-ep">Episode 5</span><span class="schedule-date">Tue, Jan 5, 2027</span></div>
      <div class="schedule-row"><span class="schedule-ep">Episode 6</span><span class="schedule-date">Tue, Jan 12, 2027</span></div>
    </div>

    <ClipsRail clips={CLIPS} />
  </section>

  <section id="about" class="about">
    <h2 class="section-title">About the Show</h2>
    <div class="about-grid">
      <div class="about-card">
        <h3>One idea</h3>
        <p>Every episode takes a single piece of the tech small businesses actually run on — your accounts, your tools, your systems — and explains it in plain words. No jargon, no hype.</p>
      </div>
      <div class="about-card">
        <h3>One task</h3>
        <p>Each episode ends with a homework task that takes about ten minutes. Small, finished steps beat big plans that never start.</p>
      </div>
      <div class="about-card">
        <h3>No selling</h3>
        <p>This show is for the Central Valley small-business community — shops with 5 to 50 people who keep this region running. There is nothing for sale here. The point is that you own your stack.</p>
      </div>
    </div>
    <p class="about-note">Carlos Cabrales III (CC3PO) works in IT in California's Central Valley and produces music as CC3PO. This is his solo show. The Village's show, <a href="/insights">CC3PO Insights</a>, lives on its own page.</p>
  </section>

  <section class="voice-cta">
    <div class="voice-card">
      <h2>Be part of the show</h2>
      <p>Carlos reads every listener message — and the best questions become episodes. Record a voice message up to two minutes: the thing that slows your team down, the question you keep meaning to ask. It goes to a private review queue, and nothing airs without your permission.</p>
      <a href="/voice/" class="btn btn-primary">Leave a voice message</a>
    </div>
  </section>

  <section class="reviews">
    <h2 class="section-title">What listeners say</h2>
    <p class="reviews-empty">The show is new — reviews are just starting to land, and this wall is waiting for its first ones. If an episode helped, a review is the best way to tell Carlos to make more:</p>
    <div class="ep-actions">
      <a href="https://podcasts.apple.com/podcast/cc3po-podcast/id6838596218" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Review on Apple Podcasts</a>
      <a href="https://open.spotify.com/show/1Ix82Mlcww5eTH7xXnkVL7" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Open in Spotify</a>
    </div>
  </section>

  <section class="capture-section">
    <CaptureForm source="homepage" />
  </section>

  <section class="also">
    <div class="also-card">
      <h2>Also from CC3PO</h2>
      <p><strong>CC3PO Insights</strong> — the Village show. A team of AI specialists breaks down what's really happening on small-business websites: compliance, security, automation, content. Season 1 is complete — all 12 episodes.</p>
      <a href="/insights" class="btn btn-primary">Visit CC3PO Insights</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-inner">
      <p>© 2026 CC3PO LLC · Lathrop, California</p>
      <div class="footer-links">
        <a href="https://cc3po.com">cc3po.com</a>
        <a href="https://insights.cc3po.com">Insights Blog</a>
        <a href="/insights">CC3PO Insights</a>
        <a href="https://feeds.transistor.fm/cc3po-podcast">RSS</a>
      </div>
    </div>
  </footer>
  <PersistentPlayer />
</Layout>

<style>
  .hero { max-width: 1080px; margin: 0 auto; padding: 3.5rem 1.25rem 2rem; }
  .hero-inner { display: flex; gap: 2.2rem; align-items: center; flex-wrap: wrap; }
  .hero-cover { border-radius: 18px; box-shadow: 0 18px 50px color-mix(in srgb, var(--brand-ink) 55%, transparent); width: 300px; height: 300px; }
  .hero-text { flex: 1 1 320px; }
  .hero-badge { display: inline-block; background: var(--brand-navy); color: var(--brand-paper); border-radius: 999px; padding: .3rem .85rem; font-size: .85rem; font-weight: 600; margin-bottom: 1rem; }
  .hero-title { font-size: 3rem; font-weight: 800; color: var(--brand-paper); line-height: 1.05; }
  .hero-title .accent { color: var(--semantic-info); }
  .hero-tagline { font-size: 1.3rem; color: var(--brand-paper); margin-top: .8rem; font-weight: 600; }
  .hero-sub { color: var(--semantic-muted); margin-top: .8rem; max-width: 34rem; }
  .disclosure { margin-top: 1rem; color: var(--semantic-info); font-size: .9rem; border-left: 3px solid var(--brand-navy); padding-left: .7rem; }
  .player-wrap { margin-top: 2.2rem; background: var(--brand-surface-dark); border: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent); border-radius: 14px; padding: 1.1rem 1.1rem .6rem; }
  .player-label { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-silver); margin-bottom: .5rem; }
  .player-wrap iframe { border: 0; width: 100%; }

  section { max-width: 1080px; margin: 0 auto; padding: 2.6rem 1.25rem 0; }
  .section-title { font-size: 1.9rem; font-weight: 800; color: var(--brand-paper); }
  .section-desc { color: var(--semantic-muted); margin-top: .4rem; }
  .section-desc a, .about-note a { text-decoration: underline; }

  .subscribe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: .8rem; margin-top: 1.4rem; }
  .subscribe-card { display: flex; align-items: center; justify-content: center; text-align: center; background: var(--brand-surface-dark); border: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent); border-radius: 12px; padding: 1rem .6rem; color: var(--brand-paper); font-weight: 600; font-size: .95rem; min-height: 44px; transition: border-color .2s, transform .2s; }
  .subscribe-card:hover { border-color: var(--semantic-info); color: var(--brand-paper); transform: translateY(-2px); }

  .ep-search { margin-top: 1.2rem; }
  .ep-search label { display: block; font-weight: 600; color: var(--brand-paper); margin-bottom: .45rem; font-size: .95rem; }
  .ep-search-row { display: flex; gap: .7rem; flex-wrap: wrap; }
  .ep-search-row input { flex: 1 1 240px; font-size: 16px; padding: .6rem .9rem; border-radius: var(--radius-sm); border: 1px solid color-mix(in srgb, var(--brand-paper) 22%, transparent); background: var(--brand-surface-dark); color: var(--brand-paper); min-height: 44px; }
  .ep-search-row input:focus { outline: 2px solid var(--semantic-focus); outline-offset: 1px; }

  .episode-list { display: grid; gap: 1rem; margin-top: 1.4rem; }
  .episode-card { background: var(--brand-surface-dark); border: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent); border-radius: 14px; padding: 1.4rem; }
  .ep-meta { font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; color: var(--semantic-info); font-weight: 700; }
  .ep-title { font-size: 1.35rem; margin-top: .35rem; }
  .ep-title a { color: var(--brand-paper); }
  .ep-title a:hover { color: var(--semantic-info); }
  .ep-desc { color: var(--semantic-muted); margin-top: .5rem; }
  .ep-actions { display: flex; gap: .7rem; margin-top: 1rem; flex-wrap: wrap; }

  .schedule-title { color: var(--brand-paper); margin-top: 2rem; font-size: 1.15rem; }
  .schedule-list { margin-top: .8rem; border: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent); border-radius: 12px; overflow: hidden; }
  .schedule-row { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1.1rem; background: color-mix(in srgb, var(--brand-navy) 30%, var(--brand-night)); border-bottom: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent); }
  .schedule-row:last-child { border-bottom: 0; }
  .schedule-ep { color: var(--brand-paper); font-weight: 600; }
  .schedule-date { color: var(--brand-silver); }

  .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.4rem; }
  .about-card { background: var(--brand-surface-dark); border: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent); border-radius: 14px; padding: 1.3rem; }
  .about-card h3 { color: var(--brand-paper); margin-bottom: .45rem; }
  .about-card p { color: var(--semantic-muted); font-size: .96rem; }
  .about-note { color: var(--semantic-muted); margin-top: 1.4rem; max-width: 46rem; }

  .voice-card { background: linear-gradient(135deg, var(--brand-navy), var(--brand-surface-dark)); border: 1px solid var(--brand-navy); border-radius: 16px; padding: 1.8rem; }
  .voice-card h2 { color: var(--brand-paper); font-size: 1.5rem; }
  .voice-card p { color: var(--semantic-muted); margin: .7rem 0 1.2rem; max-width: 44rem; }

  .reviews-empty { color: var(--semantic-muted); margin-top: .6rem; max-width: 44rem; }

  .also-card { background: linear-gradient(135deg, var(--brand-navy), var(--brand-surface-dark)); border: 1px solid var(--brand-navy); border-radius: 16px; padding: 1.8rem; }
  .also-card h2 { color: var(--brand-paper); font-size: 1.5rem; }
  .also-card p { color: var(--semantic-muted); margin: .7rem 0 1.2rem; max-width: 44rem; }

  .btn { display: inline-block; border-radius: 10px; padding: .7rem 1.3rem; font-weight: 700; font-size: .95rem; border: 0; cursor: pointer; min-height: 44px; }
  .btn-primary { background: var(--brand-navy); color: var(--brand-paper); }
  .btn-primary:hover { background: color-mix(in srgb, var(--brand-navy) 65%, var(--semantic-info)); color: var(--brand-paper); }
  .btn-outline { border: 1px solid color-mix(in srgb, var(--brand-paper) 25%, transparent); color: var(--brand-paper); }
  .btn-outline:hover { border-color: var(--semantic-info); color: var(--brand-paper); }
  .btn-sm { padding: .5rem 1rem; font-size: .88rem; }

  .footer { margin-top: 3.5rem; border-top: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent); }
  .footer-inner { max-width: 1080px; margin: 0 auto; padding: 1.6rem 1.25rem 2.2rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; color: var(--brand-silver); font-size: .9rem; }
  .footer-links { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .footer-links a { color: var(--semantic-muted); padding: .55rem 0; }

  @media (max-width: 640px) {
    .hero-title { font-size: 2.2rem; }
    .hero-cover { width: 220px; height: 220px; }
  }
</style>
