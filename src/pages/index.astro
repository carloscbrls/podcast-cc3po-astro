---
import Layout from '../layouts/Layout.astro';

// Episodes come from the show's Transistor RSS feed at build time,
// so a new episode appears here on the next deploy after it publishes.
interface Ep { num: string; title: string; date: string; iso: string; desc: string; audio: string; link: string; duration: string; secs: number; }
let episodes: Ep[] = [];
try {
  const res = await fetch('https://feeds.transistor.fm/cc3po-podcast');
  const xml = await res.text();
  const items = [...xml.matchAll(/<item>([\s\S]*?)<\/item>/g)].map((m) => m[1]);
  episodes = items.map((it) => {
    const pick = (tag: string) => {
      const m = it.match(new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`));
      return m ? m[1].replace(/<!\[CDATA\[|\]\]>/g, '').trim() : '';
    };
    const enc = it.match(/<enclosure[^>]*url="([^"]+)"/);
    const secs = parseInt(pick('itunes:duration')) || 0;
    const d = new Date(pick('pubDate'));
    return {
      num: pick('itunes:episode') || '',
      title: pick('title'),
      date: isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Los_Angeles' }),
      iso: isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10),
      desc: pick('description').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim(),
      audio: enc ? enc[1] : '',
      link: pick('link'),
      duration: secs ? `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}` : '',
      secs,
    };
  }).filter((e) => e.title);
} catch (e) { /* fall back below */ }
if (!episodes.length) {
  episodes = [{
    num: '1', title: 'Own Your Stack', date: 'Nov 23, 2026', iso: '2026-11-23',
    desc: 'One idea in plain words for Central Valley small businesses: own your stack — the tools, accounts, and systems your business runs on should answer to you, not the other way around. Plus a 10-minute homework task and a short Spanish segment.',
    audio: 'https://media.transistor.fm/0bbc4eb8/c841c488.mp3', link: 'https://share.transistor.fm/s/0bbc4eb8', duration: '6:42', secs: 402,
  }];
}

const platforms = [
  { name: 'Apple Podcasts', href: 'https://podcasts.apple.com/podcast/cc3po-podcast/id6838596218' },
  { name: 'Spotify', href: 'https://open.spotify.com/show/1Ix82Mlcww5eTH7xXnkVL7' },
  { name: 'Amazon Music', href: 'https://music.amazon.com/podcasts/4956d5c2-697d-40ff-ae4f-1c17248795e5' },
  { name: 'Pocket Casts', href: 'https://pca.st/m1ys6m9c' },
  { name: 'Deezer', href: 'https://www.deezer.com/show/1003788401' },
  { name: 'Podcast Addict', href: 'https://podcastaddict.com/podcast/cc3po-podcast/7390095' },
  { name: 'Player FM', href: 'https://player.fm/series/series-3777810' },
  { name: 'Overcast', href: 'https://overcast.fm/itunes6838596218' },
  { name: 'Castbox', href: 'https://castbox.fm/vic/6838596218' },
  { name: 'Castro', href: 'https://castro.fm/itunes/6838596218' },
  { name: 'Goodpods', href: 'https://www.goodpods.com/podcasts-aid/6838596218' },
  { name: 'RSS Feed', href: 'https://feeds.transistor.fm/cc3po-podcast' },
];

const seriesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'CC3PO Podcast',
  url: 'https://podcast.cc3po.com/',
  description: 'Carlos Cabrales III (CC3PO) — an IT professional and music producer in Lathrop, California — talks plain about the tech small businesses actually run on. One idea per episode, one 10-minute homework task, no selling.',
  image: 'https://podcast.cc3po.com/images/cc3po-podcast-cover.jpg',
  webFeed: 'https://feeds.transistor.fm/cc3po-podcast',
  author: { '@type': 'Person', name: 'Carlos Cabrales III' },
  publisher: { '@type': 'Organization', name: 'CC3PO', url: 'https://cc3po.com' },
  sameAs: [
    'https://podcasts.apple.com/podcast/cc3po-podcast/id6838596218',
    'https://open.spotify.com/show/1Ix82Mlcww5eTH7xXnkVL7',
  ],
};

const episodeJsonLd = episodes.map((ep) => ({
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: ep.title,
  episodeNumber: ep.num ? parseInt(ep.num, 10) : undefined,
  url: ep.num === '1' ? 'https://podcast.cc3po.com/episodes/own-your-stack/' : 'https://podcast.cc3po.com/',
  datePublished: ep.iso || undefined,
  duration: ep.secs ? `PT${Math.floor(ep.secs / 60)}M${ep.secs % 60}S` : undefined,
  description: ep.desc,
  associatedMedia: ep.audio ? { '@type': 'MediaObject', contentUrl: ep.audio } : undefined,
  partOfSeries: { '@type': 'PodcastSeries', name: 'CC3PO Podcast', url: 'https://podcast.cc3po.com/' },
}));

const upcoming = [
  { num: 2, date: 'Tue, Dec 1, 2026' },
  { num: 3, date: 'Wed, Dec 9, 2026' },
  { num: 4, date: 'Tue, Dec 15, 2026' },
];
---

<Layout
  title="CC3PO Podcast — Carlos Cabrales III"
  description="Carlos Cabrales III (CC3PO) — an IT professional and music producer in Lathrop, California — talks plain about the tech small businesses actually run on. One idea per episode, one 10-minute homework task, no selling."
  image="https://podcast.cc3po.com/images/cc3po-podcast-cover.jpg"
  siteName="CC3PO Podcast"
  jsonLd={[seriesJsonLd, ...episodeJsonLd]}
>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="21"/></svg>
        <span>CC3PO <strong>Podcast</strong></span>
      </a>
      <div class="nav-links">
        <a href="#episodes">Episodes</a>
        <a href="#subscribe">Subscribe</a>
        <a href="#about">About</a>
        <a href="/insights">CC3PO Insights</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="hero-inner">
      <img src="/images/cc3po-podcast-cover.jpg" alt="CC3PO Podcast cover art" class="hero-cover" width="300" height="300" />
      <div class="hero-text">
        <div class="hero-badge">🎙️ New episodes Tuesdays</div>
        <h1 class="hero-title">CC3PO <span class="accent">Podcast</span></h1>
        <p class="hero-tagline">Plain talk about the tech your business actually runs on.</p>
        <p class="hero-sub">Carlos Cabrales III — an IT professional and music producer in Lathrop, California — takes one idea per episode, gives you one 10-minute homework task, and sells you nothing. Every episode closes with a short segment in Spanish.</p>
        <p class="disclosure">Voiced with an AI clone of Carlos's voice, approved by Carlos.</p>
      </div>
    </div>
    <div class="player-wrap">
      <p class="player-label">Latest episode</p>
      <iframe width="100%" height="180" frameborder="no" scrolling="no" seamless src="https://share.transistor.fm/e/cc3po-podcast/latest" title="Latest episode player"></iframe>
    </div>
  </header>

  <section id="subscribe" class="subscribe">
    <h2 class="section-title">Listen Anywhere</h2>
    <p class="section-desc">The show is live on every major podcast app. Pick your player:</p>
    <div class="subscribe-grid">
      {platforms.map((p) => (
        <a href={p.href} class="subscribe-card" target="_blank" rel="noopener"><span>{p.name}</span></a>
      ))}
    </div>
  </section>

  <section id="episodes" class="episodes">
    <h2 class="section-title">Episodes</h2>
    <div class="episode-list">
      {episodes.map((ep) => (
        <article class="episode-card">
          <div class="ep-meta">E{ep.num} · {ep.date} · {ep.duration}</div>
          <h3 class="ep-title">{ep.title}</h3>
          <p class="ep-desc">{ep.desc}</p>
          {ep.audio && (
            <audio controls preload="none" src={ep.audio} class="ep-player">
              Your browser does not support the audio element.
            </audio>
          )}
          <div class="ep-actions">
            {ep.link && <a href={ep.link} class="btn btn-primary btn-sm" target="_blank" rel="noopener">Play Episode</a>}
            {ep.audio && <a href={ep.audio} class="btn btn-outline btn-sm">Download MP3</a>}
            {ep.num === '1' && <a href="/episodes/own-your-stack/" class="btn btn-outline btn-sm">Transcript</a>}
          </div>
        </article>
      ))}
    </div>
    <h3 class="schedule-title">Season 1 — coming up</h3>
    <div class="schedule-list">
      {upcoming.map((u) => (
        <div class="schedule-row"><span class="schedule-ep">Episode {u.num}</span><span class="schedule-date">{u.date}</span></div>
      ))}
      <div class="schedule-row"><span class="schedule-ep">Holiday break</span><span class="schedule-date">Dec 21 – Jan 4</span></div>
      <div class="schedule-row"><span class="schedule-ep">Episode 5</span><span class="schedule-date">Tue, Jan 5, 2027</span></div>
      <div class="schedule-row"><span class="schedule-ep">Episode 6</span><span class="schedule-date">Tue, Jan 12, 2027</span></div>
    </div>
  </section>

  <section id="about" class="about">
    <h2 class="section-title">About the Show</h2>
    <div class="about-grid">
      <div class="about-card">
        <h3>One idea</h3>
        <p>Every episode takes a single piece of the tech small businesses actually run on — your accounts, your tools, your systems — and explains it in plain words. No jargon, no hype.</p>
      </div>
      <div class="about-card">
        <h3>One task</h3>
        <p>Each episode ends with a homework task that takes about ten minutes. Small, finished steps beat big plans that never start.</p>
      </div>
      <div class="about-card">
        <h3>No selling</h3>
        <p>This show is for the Central Valley small-business community — shops with 5 to 50 people who keep this region running. There is nothing for sale here. The point is that you own your stack.</p>
      </div>
    </div>
    <p class="about-note">Carlos Cabrales III (CC3PO) works in IT in California's Central Valley and produces music as CC3PO. This is his solo show. The Village's show, <a href="/insights">CC3PO Insights</a>, lives on its own page.</p>
  </section>

  <section class="also">
    <div class="also-card">
      <h2>Also from CC3PO</h2>
      <p><strong>CC3PO Insights</strong> — the Village show. A team of AI specialists breaks down what's really happening on small-business websites: compliance, security, automation, content. Season 1 is complete — all 12 episodes.</p>
      <a href="/insights" class="btn btn-primary">Visit CC3PO Insights</a>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-inner">
      <p>© 2026 CC3PO LLC · Lathrop, California</p>
      <div class="footer-links">
        <a href="https://cc3po.com">cc3po.com</a>
        <a href="https://insights.cc3po.com">Insights Blog</a>
        <a href="/insights">CC3PO Insights</a>
        <a href="https://feeds.transistor.fm/cc3po-podcast">RSS</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: rgba(10,10,10,.92); backdrop-filter: blur(8px); border-bottom: 1px solid #1f2937; }
  .nav-inner { max-width: 1080px; margin: 0 auto; padding: .9rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .nav-logo { display: flex; align-items: center; gap: .55rem; color: #f3f4f6; font-weight: 600; font-size: 1.05rem; }
  .nav-logo strong { color: #60a5fa; }
  .nav-links { display: flex; gap: 1.4rem; flex-wrap: wrap; }
  .nav-links a { color: #d1d5db; font-size: .95rem; }
  .nav-links a:hover { color: #60a5fa; }

  .hero { max-width: 1080px; margin: 0 auto; padding: 3.5rem 1.25rem 2rem; }
  .hero-inner { display: flex; gap: 2.2rem; align-items: center; flex-wrap: wrap; }
  .hero-cover { border-radius: 18px; box-shadow: 0 18px 50px rgba(0,0,0,.55); width: 300px; height: 300px; }
  .hero-text { flex: 1 1 320px; }
  .hero-badge { display: inline-block; background: #1e3a8a; color: #bfdbfe; border-radius: 999px; padding: .3rem .85rem; font-size: .85rem; font-weight: 600; margin-bottom: 1rem; }
  .hero-title { font-size: 3rem; font-weight: 800; color: #f9fafb; line-height: 1.05; }
  .hero-title .accent { color: #60a5fa; }
  .hero-tagline { font-size: 1.3rem; color: #e5e7eb; margin-top: .8rem; font-weight: 600; }
  .hero-sub { color: #9ca3af; margin-top: .8rem; max-width: 34rem; }
  .disclosure { margin-top: 1rem; color: #93c5fd; font-size: .9rem; border-left: 3px solid #2563eb; padding-left: .7rem; }
  .player-wrap { margin-top: 2.2rem; background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 1.1rem 1.1rem .6rem; }
  .player-label { font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: #9ca3af; margin-bottom: .5rem; }
  .player-wrap iframe { border: 0; width: 100%; }

  section { max-width: 1080px; margin: 0 auto; padding: 2.6rem 1.25rem 0; }
  .section-title { font-size: 1.9rem; font-weight: 800; color: #f9fafb; }
  .section-desc { color: #9ca3af; margin-top: .4rem; }

  .subscribe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: .8rem; margin-top: 1.4rem; }
  .subscribe-card { display: flex; align-items: center; justify-content: center; text-align: center; background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 1rem .6rem; color: #e5e7eb; font-weight: 600; font-size: .95rem; transition: border-color .2s, transform .2s; }
  .subscribe-card:hover { border-color: #2563eb; color: #fff; transform: translateY(-2px); }

  .episode-list { display: grid; gap: 1rem; margin-top: 1.4rem; }
  .episode-card { background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 1.4rem; }
  .ep-meta { font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; color: #60a5fa; font-weight: 700; }
  .ep-title { font-size: 1.35rem; color: #f9fafb; margin-top: .35rem; }
  .ep-desc { color: #9ca3af; margin-top: .5rem; }
  .ep-player { width: 100%; margin-top: 1rem; }
  .ep-actions { display: flex; gap: .7rem; margin-top: 1rem; flex-wrap: wrap; }

  .schedule-title { color: #f3f4f6; margin-top: 2rem; font-size: 1.15rem; }
  .schedule-list { margin-top: .8rem; border: 1px solid #1f2937; border-radius: 12px; overflow: hidden; }
  .schedule-row { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1.1rem; background: #0d1526; border-bottom: 1px solid #1f2937; }
  .schedule-row:last-child { border-bottom: 0; }
  .schedule-ep { color: #e5e7eb; font-weight: 600; }
  .schedule-date { color: #9ca3af; }

  .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.4rem; }
  .about-card { background: #111827; border: 1px solid #1f2937; border-radius: 14px; padding: 1.3rem; }
  .about-card h3 { color: #f9fafb; margin-bottom: .45rem; }
  .about-card p { color: #9ca3af; font-size: .96rem; }
  .about-note { color: #9ca3af; margin-top: 1.4rem; max-width: 46rem; }

  .also-card { background: linear-gradient(135deg, #0d1b3e, #111827); border: 1px solid #1e3a8a; border-radius: 16px; padding: 1.8rem; }
  .also-card h2 { color: #f9fafb; font-size: 1.5rem; }
  .also-card p { color: #c7d2fe; margin: .7rem 0 1.2rem; max-width: 44rem; }

  .btn { display: inline-block; border-radius: 10px; padding: .7rem 1.3rem; font-weight: 700; font-size: .95rem; }
  .btn-primary { background: #2563eb; color: #fff; }
  .btn-primary:hover { background: #1d4ed8; color: #fff; }
  .btn-outline { border: 1px solid #374151; color: #e5e7eb; }
  .btn-outline:hover { border-color: #60a5fa; color: #fff; }
  .btn-sm { padding: .5rem 1rem; font-size: .88rem; }

  .footer { margin-top: 3.5rem; border-top: 1px solid #1f2937; }
  .footer-inner { max-width: 1080px; margin: 0 auto; padding: 1.6rem 1.25rem 2.2rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; color: #6b7280; font-size: .9rem; }
  .footer-links { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .footer-links a { color: #9ca3af; }

  @media (max-width: 640px) {
    .hero-title { font-size: 2.2rem; }
    .hero-cover { width: 220px; height: 220px; }
  }
</style>
